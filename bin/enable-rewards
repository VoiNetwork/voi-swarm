#!/bin/bash

source "${HOME}/voi/bin/.helpers/util.sh"

util_validate_supported_node_type "participation"
util_validate_running_container

if [ -z "$1" ]; then
    echo "Please provide an account address as a parameter."
    echo "Example: enable-rewards <account_address>"
    exit 1
fi

account_info=$(util_get_account_dump "$1") || exit 1

if [[ $(jq -r '.ie // false' <<< "${account_info}") == "true" ]]; then
  echo "Account $1 is already opted in to proposer rewards."
  util_print_proposer_rewards_status "$1" "${account_info}"
  exit 0
fi

balance=$(jq -r '.algo // 0' <<< "${account_info}")

if ! util_has_proposer_rewards_balance "${balance}"; then
  echo "WARNING: Account $1 is not eligible for proposer rewards."
  echo "Its balance is $((balance / 1000000)) Voi, and rewards are only paid to accounts with a balance between 30,000 and 70,000,000 Voi."
  echo "You can still opt in now, but the account won't receive rewards until its balance is within that range."
  echo ""
fi

echo "This will register your current participation key again with a 2 Voi fee, opting account $1 in to proposer rewards."
echo "No new participation key is generated."
# shellcheck disable=SC2162
read -p "Continue? (yes/no): " prompt || exit 1
while [[ ${prompt} != "yes" && ${prompt} != "no" ]]
  do
  # shellcheck disable=SC2162
    read -p "Type either yes or no: " prompt || exit 1
done
if [[ ${prompt} == "no" ]]; then
  exit 0
fi

docker exec -e account_addr="$1" -e fee="${PROPOSER_REWARDS_KEYREG_FEE}" -it "${CONTAINER_ID}" bash -c '/node/bin/goal account changeonlinestatus -a "${account_addr}" -o=1 --fee "${fee}"' || exit 1
sleep 1
"${HOME}"/voi/bin/get-participation-status "$1"
